# Copy to .env and adjust. Read by `pnpm dev` (scripts/run.mjs).
SERVER_PORT=9999
WEB_PORT=5499
WEBHOOK_PORT=9900
# The Node.js Zalo service (zalo-service/), reached through the web app's /zalo-api proxy. It listens on 127.0.0.1 only.
ZALO_PORT=8902
SERVER_HOST=127.0.0.1
# 0.0.0.0 opens the web port to localhost, LAN and Tailscale (the app refuses other addresses); use 127.0.0.1 for this computer only.
# The API stays on loopback; only the web app (which calls it from this computer) is reachable.
# Domain names are refused unless listed in WEB_ALLOWED_HOSTS.
WEB_HOST=0.0.0.0
# Optional additional DNS names (comma-separated, no scheme or port).
# WEB_ALLOWED_HOSTS=my-machine.my-tailnet.ts.net
# Where SocialTeam keeps its data: bots, chats, campaigns, posts, keys and uploads. Every part (server, web app, Zalo
# service) reads this one setting. Change it to keep the data somewhere else. "~", %USERPROFILE% and $HOME are expanded.
BOTTEAM_DATA_DIR=~/.botsocial
# Optional. Defaults to trying Edge, Chrome and then Playwright Chromium.
# BOTTEAM_BROWSER_CHANNEL=msedge
# Set to 0 to show the browser window on the host.
# BOTTEAM_BROWSER_HEADLESS=1
# Stop inactive browser processes after 15 minutes. Set to 0 to keep them running.
# BOTTEAM_BROWSER_IDLE_SECONDS=900
# Optional E2B Computer use. Set the API key in Settings. Cloud uses its default URLs.
# E2B_API_URL=http://e2b-host:3000
# E2B_SANDBOX_URL=http://e2b-host:3002
# E2B_DOMAIN=e2b-host.example
# BOTTEAM_COMPUTER_TEMPLATE=desktop
# Optional OpenSandbox Computer use (a server you run with Docker). Set the API key in Settings.
# OPENSANDBOX_URL=http://opensandbox-host:8080
# BOTTEAM_COMPUTER_IMAGE=botteam/desktop:1
# BOTTEAM_COMPUTER_IDLE_S=900
